@article{Sonehara_2025,
  abstract = {Psoriasis vulgaris (PsV) is an immune-mediated inflammatory skin disorder with complex genetic architecture. Most genome-wide association studies (GWASs) of PsV have been limited to analyzing common single-nucleotide variants in Europeans, lacking diversity in the variant spectrum and ancestral background. To investigate the contribution of rare variants (RVs) and structural variants (SVs), we perform a whole-genome sequencing study involving 1,415 PsV cases and 3,968 controls in Japanese. A GWAS signal at IFNLR1 is fine-mapped to a 3.3-kb deletion SV disrupting an epithelium-specific putative enhancer, which is validated by PacBio long-read sequencing. Gene-based RV analyses identify two susceptibility genes: IFIH1 (p = 9.8 × 10-6) and CERCAM (p = 4.1 × 10-7). Notably, IL36RN, a causative gene for generalized pustular psoriasis, a rare and lethal multi-systemic inflammatory disorder, is associated with common PsV (p = 1.2 × 10-4). Finally, Cercam knockout (Cercam-/-) in an imiquimod-induced psoriasis mouse model aggravates dermatitis with elevated T cell retention in the subepidermis. Our study elucidates the overlooked genetic basis of PsV.},
  title={Whole-genome sequencing reveals rare and structural variants contributing to psoriasis and identifies CERCAM as a risk gene},
  volume={5},
  ISSN={2666-979X},
  url={http://dx.doi.org/10.1016/j.xgen.2025.100978},
  DOI={10.1016/j.xgen.2025.100978},
  number={10},
  journal={Cell Genomics},
  publisher={Elsevier BV},
  author={Sonehara, Kyuto and Watanabe, Rei and Matsumura, Yutaka and Mitsui, Yuichi and Ogawa, Yosuke and Odomari, Kaori and Sakaue, Saori and Namba, Shinichi and Komuro, Mariko and Edamoto, Mio and Watanabe, Junya and Hirota, Tomomitsu and Arase, Noriko and Nakamura, Yuumi and Nakajima, Kimiko and Okamoto, Takashi and Nishikawa, Rika and Yamamoto, Kenichi and Suzuki, Ken and Kishikawa, Toshihiro and Edahiro, Ryuya and Shirai, Yuya and Naito, Tatsuhiko and Sasa, Noah and Ishitsuka, Yosuke and Furuta, Junichi and Kunimoto, Kayo and Kajihara, Ikko and Fukushima, Satoshi and Miyachi, Hideaki and Matsue, Hiroyuki and Kamata, Masahiro and Momose, Mami and Miyagawa, Ippei and Tanaka, Hiroaki and Ueno, Masanobu and Bito, Toshinori and Nagai, Hiroshi and Ikeda, Tetsuya and Horikawa, Tatsuya and Adachi, Atsuko and Matsubara, Tsukasa and Nishida, Emi and Matsuda, Koichi and Shojima, Nobuhiro and Nakagawa, Ikuma and Asano, Yoshihide and Sato, Shinichi and Imafuku, Shinichi and Tada, Yayoi and Nishigori, Chikako and Jinnin, Masatoshi and Ihn, Hironobu and Asahina, Akihiko and Saeki, Hidehisa and Yamauchi, Toshimasa and Kadowaki, Takashi and Kawamura, Tatsuyoshi and Shimada, Shinji and Katayama, Ichiro and Higasa, Koichiro and Noguchi, Emiko and Sano, Shigetoshi and Tanaka, Yoshiya and Matsuda, Fumihiko and Kumanogoh, Atsushi and Tamari, Mayumi and Satoh, Takashi and Fujimoto, Manabu and Morita, Akimichi and Okada, Yukinori},
  year={2025},
