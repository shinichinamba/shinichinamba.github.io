 @article{Koyanagi_2024,
   abstract = {An East Asian–specific variant on aldehyde dehydrogenase 2 ( ALDH2 rs671, G>A) is the major genetic determinant of alcohol consumption. We performed an rs671 genotype-stratified genome-wide association study meta-analysis of alcohol consumption in 175,672 Japanese individuals to explore gene-gene interactions with rs671 behind drinking behavior. The analysis identified three genome-wide significant loci ( GCKR, KLB, and ADH1B) in wild-type homozygotes and six ( GCKR, ADH1B, ALDH1B1, ALDH1A1, ALDH2, and GOT2) in heterozygotes, with five showing genome-wide significant interaction with rs671. Genetic correlation analyses revealed ancestry-specific genetic architecture in heterozygotes. Of the discovered loci, four ( GCKR, ADH1B, ALDH1A1, and ALDH2) were suggested to interact with rs671 in the risk of esophageal cancer, a representative alcohol-related disease. Our results identify the genotype-specific genetic architecture of alcohol consumption and reveal its potential impact on alcohol-related disease risk.},
  title={Genetic architecture of alcohol consumption identified by a genotype-stratified GWAS and impact on esophageal cancer risk in Japanese people},
  volume={10},
  ISSN={2375-2548},
  url={http://dx.doi.org/10.1126/sciadv.ade2780},
  DOI={10.1126/sciadv.ade2780},
  number={4},
  journal={Science Advances},
  publisher={American Association for the Advancement of Science (AAAS)},
  author={Koyanagi, Yuriko N. and Nakatochi, Masahiro and Namba, Shinichi and Oze, Isao and Charvat, Hadrien and Narita, Akira and Kawaguchi, Takahisa and Ikezaki, Hiroaki and Hishida, Asahi and Hara, Megumi and Takezaki, Toshiro and Koyama, Teruhide and Nakamura, Yohko and Suzuki, Sadao and Katsuura-Kamano, Sakurako and Kuriki, Kiyonori and Nakamura, Yasuyuki and Takeuchi, Kenji and Hozawa, Atsushi and Kinoshita, Kengo and Sutoh, Yoichi and Tanno, Kozo and Shimizu, Atsushi and Ito, Hidemi and Kasugai, Yumiko and Kawakatsu, Yukino and Taniyama, Yukari and Tajika, Masahiro and Shimizu, Yasuhiro and Suzuki, Etsuji and Hosono, Yasuyuki and Imoto, Issei and Tabara, Yasuharu and Takahashi, Meiko and Setoh, Kazuya and Matsuda, Koichi and Nakano, Shiori and Goto, Atsushi and Katagiri, Ryoko and Yamaji, Taiki and Sawada, Norie and Tsugane, Shoichiro and Wakai, Kenji and Yamamoto, Masayuki and Sasaki, Makoto and Matsuda, Fumihiko and Okada, Yukinori and Iwasaki, Motoki and Brennan, Paul and Matsuo, Keitaro},
  year={2024},
